{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AmitwalaH/doriki/main/schema/manifest.v1.json",
  "$ref": "#/$defs/Manifest",
  "$defs": {
    "Manifest": {
      "properties": {
        "manifest_version": {
          "type": "integer"
        },
        "pod": {
          "$ref": "#/$defs/ManifestPod"
        },
        "node": {
          "$ref": "#/$defs/ManifestNode"
        },
        "container": {
          "$ref": "#/$defs/ManifestContainer"
        },
        "engine": {
          "$ref": "#/$defs/ManifestEngine"
        },
        "model": {
          "$ref": "#/$defs/ManifestModel"
        },
        "accelerator": {
          "$ref": "#/$defs/ManifestAccelerator"
        },
        "caches": {
          "$ref": "#/$defs/ManifestCaches"
        },
        "fingerprint": {
          "type": "string",
          "description": "Fingerprint is \"sha256:\" and the hash of every other field except the pod's name and\nUID, so two boots of the same deployment share it (DESIGN.md section 4.3)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "manifest_version"
      ],
      "description": "Manifest is the deployment manifest (DESIGN.md section 4.3)."
    },
    "ManifestAccelerator": {
      "properties": {
        "vendor": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ManifestAccelerator comes from node labels and container limits only; doriki reads no GPU."
    },
    "ManifestCaches": {
      "properties": {
        "torch_compile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ManifestCaches is what the engine log said about its caches."
    },
    "ManifestContainer": {
      "properties": {
        "image": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env_allowlist": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ManifestContainer is the profiled container."
    },
    "ManifestEngine": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "parser_pack": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ManifestModel": {
      "properties": {
        "ref": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Source is the host the weights download from, derived from Ref by manifest.ModelSource;\nomitted when Ref is a local path or unknown."
        },
        "loaded_gib": {
          "type": "number",
          "description": "LoadedGiB is the memory the engine reported for the loaded weights: the model's size in\nmemory, which differs from its size on disk when the dtype or quantization changes."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ManifestNode": {
      "properties": {
        "name": {
          "type": "string"
        },
        "instance_type": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "kubelet": {
          "type": "string",
          "description": "Kubelet is the node's status.nodeInfo.kubeletVersion, as written (v1.33.2)."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ManifestPod": {
      "properties": {
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "description": "Owner is the workload, Kind/name: a ReplicaSet's Deployment when known."
        },
        "owner_ref": {
          "type": "string",
          "description": "OwnerRef is the pod's own ownerReferences entry, Kind/name, as written on the pod."
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
